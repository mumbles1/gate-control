{
  "name": "Gate Control by Turnage Automation",
  "short_name": "Gates",
  "description": "Monitor and control MQTT-connected gates.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f4f0",
  "theme_color": "#132936",
  "orientation": "any",
  "icons": [
    { "src": "/gate-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "/?configurationFile=1",
      "accept": {
        "application/vnd.turnageautomation.gate-control+json": [".gateconfig"],
        "application/json": [".gateconfig"]
      },
      "launch_type": "single-client"
    }
  ]
}
